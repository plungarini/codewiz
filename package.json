{
  "name": "code-whiz-ai",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "deploy": "ng deploy",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploySupabase": "yarn updateSecrets && yarn sb-aiSearch && yarn sb-search && yarn sb-chatTitle",
    "sb-chatTitle": "npx supabase functions deploy chat-title --project-ref rbikifjpcodmtsgggpbk",
    "sb-aiSearch": "npx supabase functions deploy ai-docs --project-ref rbikifjpcodmtsgggpbk",
    "sb-search": "npx supabase functions deploy search --project-ref rbikifjpcodmtsgggpbk",
    "updateSecrets": "npx supabase secrets set --env-file ./supabase/.env"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.0.0",
    "@angular/common": "^16.0.0",
    "@angular/compiler": "^16.0.0",
    "@angular/core": "^16.0.0",
    "@angular/fire": "^7.5.0",
    "@angular/forms": "^16.0.0",
    "@angular/platform-browser": "^16.0.0",
    "@angular/platform-browser-dynamic": "^16.0.0",
    "@angular/router": "^16.0.0",
    "@imgix/angular": "^1.1.11",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/marked": "4.3.0",
    "clipboard": "2.0.11",
    "highlight.js": "^11.8.0",
    "lodash-es": "^4.17.21",
    "marked": "4.3.0",
    "ngx-clipboard": "^16.0.0",
    "ngx-markdown": "^16.0.0",
    "rxjs": "~7.8.0",
    "sse.js": "^0.6.1",
    "supabase": "^1.82.6",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.0.0",
    "@angular/cli": "~16.0.0",
    "@angular/compiler-cli": "^16.0.0",
    "@types/jasmine": "~4.3.0",
    "@types/lodash-es": "^4.17.8",
    "autoprefixer": "^10.4.14",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
